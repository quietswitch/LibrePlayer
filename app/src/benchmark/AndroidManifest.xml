<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <provider
            android:name=".benchmark.SynchronizationProbeProvider"
            android:authorities="${applicationId}.synchronization-probe"
            android:exported="true" />

        <provider
            android:name=".benchmark.ArtworkFixtureDocumentProvider"
            android:authorities="${applicationId}.artwork-fixture-document"
            android:exported="false" />

        <provider
            android:name=".benchmark.PlaybackLoadProbeProvider"
            android:authorities="${applicationId}.playback-load-probe"
            android:exported="true" />

        <provider
            android:name=".benchmark.MemoryResourceProbeProvider"
            android:authorities="${applicationId}.memory-resource-probe"
            android:exported="true" />
    </application>

</manifest>
